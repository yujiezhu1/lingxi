{
  "name": "lingxi-hub",
  "version": "0.6.0",
  "description": "灵犀 Lingxi — local-first context hub that lets different AI agents and sessions share handoffs, topics and knowledge.",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "lingxi": "dist/cli/index.js",
    "lx": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:seed": "node scripts/demo-seed.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "keywords": [
    "mcp",
    "agent",
    "context",
    "handoff",
    "memory",
    "claude-code",
    "codex",
    "cursor",
    "pi"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.63.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yujiezhu1/lingxi.git"
  },
  "homepage": "https://github.com/yujiezhu1/lingxi#readme",
  "bugs": {
    "url": "https://github.com/yujiezhu1/lingxi/issues"
  }
}
