{
  "name": "lingxi-hub",
  "version": "0.2.1",
  "description": "灵犀 Lingxi — local-first context hub that lets different AI agents and sessions share handoffs, topics and knowledge.",
  "type": "module",
  "license": "MIT",
  "bin": {
